---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import {
  defaultLang,
  getLang,
  languages,
  ogLocales,
  pathWithoutLocale,
  useTranslations,
  type Lang,
} from "../i18n/utils";
import "../styles/global.css";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const title = t("meta.title");
const description = t("meta.description");

const path = pathWithoutLocale(Astro.url.pathname, lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const otherLangs = (Object.keys(languages) as Lang[]).filter(
  (code) => code !== lang,
);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Marcel Esplugas Jacobo",
  jobTitle: "Full Stack Developer",
  url: new URL("/", Astro.site),
  image: new URL("/logo.png", Astro.site),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Barcelona",
    addressCountry: "ES",
  },
  knowsAbout: [
    "React",
    "Node.js",
    "TypeScript",
    "JavaScript",
    "Tailwind CSS",
    "Express",
    "MySQL",
    "Docker",
  ],
  sameAs: [
    "https://github.com/JacobsM14",
    "https://www.linkedin.com/in/m-esplugas/",
  ],
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Same color as --color-dark in global.css -->
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <script
      defer
      src="https://analytics.arcedo.dev/script.js"
      data-website-id="73f03824-7e23-47d6-90aa-631a056638e2"
    ></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Marcel Esplugas Jacobo" />
    <link rel="canonical" href={canonical} />
    {
      Object.keys(languages).map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={getAbsoluteLocaleUrl(code, path)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl(defaultLang, path)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marcel Esplugas Jacobo" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("meta.ogImageAlt")} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      otherLangs.map((code) => (
        <meta property="og:locale:alternate" content={ogLocales[code]} />
      ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t("meta.ogImageAlt")} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
  </body>
</html>
