---
import { useTranslations } from "../../../i18n/utils";
import { isAvailable } from "../../../data/profile";
import Card from "../../ui/Card.astro";

interface Props {
  class?: string;
}

const t = useTranslations(Astro.currentLocale);
---

<Card
  class:list={[
    "p-2 flex flex-col items-center justify-center",
    isAvailable && "bg-green-400/10",
    Astro.props.class,
  ]}
>
  <div class="flex items-center justify-center gap-3">
    <span
      class:list={[
        "w-2 h-2 rounded-full animate-pulse",
        isAvailable ? "bg-green-500" : "bg-orange-600",
      ]}
    ></span>
    <p class={isAvailable ? "text-green-600" : "text-orange-600"}>
      {isAvailable ? t("labels.available") : t("labels.busy")}
    </p>
  </div>
  <p class="text-gray-light text-sm text-center">
    {isAvailable ? t("labels.availableDesc") : t("labels.busyDesc")}
  </p>
</Card>
