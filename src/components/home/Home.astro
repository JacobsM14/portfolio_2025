---
import { useTranslations } from "../../i18n/utils";

import { books } from "../../data/books";
import { songs } from "../../data/songs";

import Card from "../ui/Card.astro";
import Header from "../layout/Header.astro";
import Profile from "./profile/Profile.astro";
import GithubActivity from "./profile/GithubActivity";
import Socials from "./profile/Socials.astro";
import Projects from "./projects/Projects.astro";
import ProjectsModal from "./projects/ProjectsModal.astro";
import Technologies from "./skills/Technologies.astro";
import NowPlaying from "./extras/NowPlaying";
import Tools from "./skills/Tools.astro";
import Languages from "./skills/Languages.astro";
import Availability from "./availability/Availability.astro";
import Preferences from "./availability/Preferences.astro";
import Experiences from "./career/Experiences.astro";
import Studies from "./career/Studies.astro";
import Donut from "./extras/Donut.astro";
import RecentBook from "./extras/RecentBook";

const t = useTranslations(Astro.currentLocale);
---

<main class="w-full min-h-screen flex items-center justify-center py-4 md:py-2 xl:py-20 desktop:h-dvh desktop:min-h-0">
  <div class="w-[98vw] max-w-350 grid grid-cols-1 gap-4 desktop:gap-3 p-2 xl:w-[94vw] md:min-h-[85vh] md:grid-cols-9 md:grid-rows-9 desktop:min-h-0 desktop:h-[min(100%,1150px)]">
    <Header class="mb-2 md:col-span-9 md:mb-0" />

    <div class="flex flex-col gap-4 desktop:gap-3 md:col-span-3 md:row-span-8 md:grid md:grid-cols-7 md:grid-rows-6">
      <Profile class="md:col-span-7 md:row-span-3 md:p-3 xl:p-0" />
      <div class="flex flex-col gap-4 desktop:gap-3 md:col-span-7 md:row-span-3 md:grid md:grid-cols-7">
        <Card class="bg-dark flex flex-col items-center justify-center gap-4 desktop:gap-3 text-white mb-2 overflow-hidden md:col-span-5 xl:col-span-6 md:mb-0 desktop:@container-size">
          <div class="w-full px-3 [&_svg]:w-full [&_svg]:h-auto desktop:[&_svg]:max-h-[calc(100cqh-3rem)]">
            <GithubActivity
              client:only="react"
              totalCountLabel={t("labels.contributions")}
              errorMessage={t("labels.calendarError")}
            />
          </div>
        </Card>
        <Socials class="flex-row mb-2 md:col-span-2 xl:col-span-1 md:row-span-2 md:flex-col md:gap-4 md:mb-0" />
        <Card class="hidden md:flex bg-green-400/10 items-center justify-center text-white md:col-span-5 xl:col-span-6 desktop:@container-size">
          <NowPlaying
            client:only="react"
            label={t("labels.recentlyPlayed")}
            songs={songs.map((song) => ({ ...song, image: song.image.src }))}
          />
        </Card>
      </div>
    </div>
    <Projects variant="strip" class="flex md:hidden" />
    <div class="flex flex-col gap-4 desktop:gap-3 md:col-span-6 md:row-span-2 md:grid md:grid-cols-6 lg:grid-cols-12 md:grid-rows-2">
      <Technologies class="h-fit md:h-full md:col-span-4 lg:col-span-6 md:row-span-2" />
      <Tools class="md:col-span-2 lg:col-span-3 md:row-span-2" />
      <Languages class="md:hidden lg:block lg:col-span-3 md:row-span-2" />
    </div>
    <div class="grid grid-cols-2 gap-4 desktop:gap-3 md:hidden lg:grid lg:col-span-2 lg:row-span-3 lg:grid-cols-1 lg:grid-rows-[auto_1fr] 2xl:grid-cols-6 2xl:grid-rows-5">
      <Availability class="lg:py-4 2xl:py-2 2xl:col-span-3 2xl:row-span-2" />
      <Preferences class="2xl:col-span-3 2xl:row-span-5" />
      <Donut class="hidden 2xl:flex 2xl:col-span-3 2xl:row-span-3" />
    </div>
    <Experiences class="md:col-span-4 md:row-span-3 lg:col-span-2 2xl:col-span-3" />
    <Studies class="md:col-span-2 md:row-span-3 2xl:col-span-1" />
    <Projects
      variant="block"
      class="hidden md:flex md:col-span-6 md:row-span-3 lg:col-span-4"
    />
    <Card class="hidden lg:block p-4 bg-linear-to-br from-orange-500/10 to-yellow-500/10 overflow-hidden lg:col-span-2 lg:row-span-3">
      <div class="@container flex flex-col h-full">
        <h2 class="text-white font-bold">{t("labels.recentReading")}</h2>
        <RecentBook
          client:only="react"
          books={books.map((book) => ({
            title: t(`books.${book.id}.title`),
            author: book.author,
            cover: book.cover.src,
          }))}
        />
      </div>
    </Card>
  </div>
  <ProjectsModal />
</main>
