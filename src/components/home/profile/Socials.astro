---
import { useTranslations } from "../../../i18n/utils";
import { socials } from "../../../data/socials";
import Card from "../../ui/Card.astro";

interface Props {
  class?: string;
}

const t = useTranslations(Astro.currentLocale);
const buttonClass =
  "p-2 rounded-lg border border-gray-normal text-white bg-black hover:bg-primary inline-flex items-center justify-center cursor-pointer";
  
---

<Card
  class:list={[
    "bg-linear-to-b from-indigo-500/10 to-blue-500/10 flex items-center justify-center gap-2 py-2 px-2",
    Astro.props.class,
  ]}
>
  {
    socials.map((social) =>
      social.type === "email" ? (
        <button
          type="button"
          data-copy-email={social.address}
          aria-label={t("labels.copyEmail")}
          title={t("labels.copyEmail")}
          class={buttonClass}
        >
          <social.icon />
        </button>
      ) : (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
          title={social.label}
          class={buttonClass}
        >
          <social.icon />
        </a>
      ),
    )
  }
</Card>

<div role="status" class="sr-only" data-email-status></div>
<div
  aria-hidden="true"
  data-email-toast
  class="fixed z-10 bg-primary text-white bottom-4 left-1/2 -translate-x-1/2 px-4 py-2 text-center rounded-lg transition-all duration-500 opacity-0 translate-y-10 pointer-events-none data-visible:opacity-100 data-visible:translate-y-0"
>
  {t("labels.mailCopied")}
</div>

<script>
  const status = document.querySelector<HTMLElement>("[data-email-status]")!;
  const toast = document.querySelector<HTMLElement>("[data-email-toast]")!;
  let timer: ReturnType<typeof setTimeout> | undefined;

  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-email]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const address = button.dataset.copyEmail!;

        try {
          await navigator.clipboard.writeText(address);
        } catch {
          window.location.href = `mailto:${address}`;
          return;
        }

        status.textContent = toast.textContent;
        toast.dataset.visible = "";
        clearTimeout(timer);
        timer = setTimeout(() => {
          status.textContent = "";
          delete toast.dataset.visible;
        }, 3000);
      });
    });
</script>
