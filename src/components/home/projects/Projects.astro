---
import { useTranslations } from "../../../i18n/utils";
import { projects } from "../../../data/projects";
import SectionTitle from "../../ui/SectionTitle.astro";
import ProjectCard from "./ProjectCard.astro";
import ProjectsIcon from "../../../assets/icons/projects.svg";
import GridIcon from "../../../assets/icons/grid.svg";

interface Props {
  // "strip" scrolls sideways (mobile), "block" fills its grid area
  variant?: "strip" | "block";
  class?: string;
}

const { variant = "block", class: className } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const isStrip = variant === "strip";
const featured = projects.filter(
  (project) => "featured" in project && project.featured,
);
---

<!-- "block": when the card is narrow, "See all" moves to its own row -->
<div
  class:list={[
    "border border-gray-normal rounded-3xl overflow-hidden",
    !isStrip && "@container",
    className,
  ]}
>
  <div class="flex flex-col overflow-y-auto h-full w-full">
    <SectionTitle icon={ProjectsIcon} class="pl-2 pt-2">
      {t("labels.projects")}
    </SectionTitle>
    <div
      class:list={[
        "w-full gap-4 desktop:gap-3 p-3 desktop:pt-2",
        isStrip
          ? "flex overflow-x-auto"
          : "flex-1 grid grid-cols-2 @min-[480px]:flex",
      ]}
    >
      {
        featured.map((project) => (
          <ProjectCard
            project={project}
            variant="compact"
            class={isStrip ? "w-64 shrink-0" : "flex-1 min-w-0"}
          />
        ))
      }
      <button
        type="button"
        data-open-projects
        aria-haspopup="dialog"
        class:list={[
          "shrink-0 p-2 rounded-lg border border-dashed border-gray-normal text-primary text-sm font-bold text-center flex items-center justify-center gap-2 cursor-pointer transition-colors hover:border-primary hover:bg-primary/10",
          isStrip
            ? "w-28 flex-col"
            : "col-span-2 @min-[480px]:w-28 @min-[480px]:flex-col",
        ]}
      >
        <GridIcon />
        <span>{t("labels.seeAllProjects")}</span>
        <span class="text-gray-light font-normal">({projects.length})</span>
      </button>
    </div>
  </div>
</div>
