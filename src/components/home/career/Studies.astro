---
import { useTranslations } from "../../../i18n/utils";
import { studies } from "../../../data/profile";
import Card from "../../ui/Card.astro";
import SectionTitle from "../../ui/SectionTitle.astro";
import StudiesIcon from "../../../assets/icons/studies.svg";

interface Props {
  class?: string;
}

const t = useTranslations(Astro.currentLocale);
---

<Card
  class:list={[
    "p-4 desktop:p-3 flex flex-col bg-linear-to-br from-indigo-500/10 to-purple-500/10",
    Astro.props.class,
  ]}
>
  <SectionTitle icon={StudiesIcon}>{t("labels.studies")}</SectionTitle>
  <ul
    class="mt-4 desktop:mt-2 min-h-0 flex flex-col overflow-y-auto wrap-break-word"
  >
    {
      studies.map((study) => (
        <li class="mb-2 text-xs">
          <p class="text-white font-bold">
            {t(`studies.${study.id}.degree`)}
          </p>
          <p class="text-gray-light">{study.institution}</p>
          <p class="text-gray-light">{study.years}</p>
        </li>
      ))
    }
  </ul>
</Card>
