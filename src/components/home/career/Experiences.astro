---
import { useTranslations } from "../../../i18n/utils";
import { experiences } from "../../../data/profile";
import Card from "../../ui/Card.astro";
import SectionTitle from "../../ui/SectionTitle.astro";
import ExperienceIcon from "../../../assets/icons/experience.svg";

interface Props {
  class?: string;
}

const t = useTranslations(Astro.currentLocale);
---

<Card class:list={["p-4 desktop:p-3 flex flex-col", Astro.props.class]}>
  <SectionTitle icon={ExperienceIcon}>{t("labels.experiences")}</SectionTitle>
  <ul
    class="mt-4 desktop:mt-2 min-h-0 overflow-y-auto grid grid-cols-[repeat(auto-fit,minmax(11rem,1fr))] gap-x-4 content-start"
  >
    {
      experiences.map((experience) => (
        <li class="mb-2 desktop:mb-0.5 border-l-2 border-primary p-2 desktop:py-0.5 text-sm desktop:leading-tight">
          <p class="text-white font-bold">
            {t(`experiences.${experience.id}.position`)}
          </p>
          <p class="text-gray-light">{experience.company}</p>
          <p class="text-gray-light">
            {t(`experiences.${experience.id}.duration`)}
          </p>
        </li>
      ))
    }
  </ul>
</Card>
